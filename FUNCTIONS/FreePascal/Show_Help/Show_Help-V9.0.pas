procedure Show_Help;
begin
    Show_Version;
    WriteLn('');
    WriteLn('Ejder file organizer - FreePascal translation of Sort-V9.0.sh');
    WriteLn('');
    WriteLn('MODES:');
    WriteLn('   --mode=MODE        copy/move/remove (default: print)');
    WriteLn('');
    WriteLn('STRUCTURE:');
    WriteLn('  --dirs=LEVELS      directory levels: accessed created extension format mime mime-main mime-sub modified random size year');
    WriteLn('  --subdirs=LEVELS   sub-levels below --dirs: format mime-sub');
    WriteLn('  --rename=VALUE       rename mode: extension md5 none random sha256');
    WriteLn('  --extension=VALUE     extension mode: none/mime/mime-sub/mime-ext/literal');
    WriteLn('');
    WriteLn('FILTERS / SCOPE:');
    WriteLn('  --type=VALUE     only files whose MIME contains VALUE');
    WriteLn('  --source=DIR      start point');
    WriteLn('  --target=DIR      root for the new tree');
    WriteLn('  --recursive     walk subdirectories');
    WriteLn('');
    WriteLn('EXTRAS:');
    WriteLn('  --probe[=md|sha|size]  probe files, do not sort');
    WriteLn('  --title           rename to title');
    WriteLn('  --pause=SEC      sleep between files');
    WriteLn('  --log=FILE       append an action log');
    WriteLn('  --self-test    run built-in checks');
    WriteLn('');
    WriteLn('  --help');
end;
